# ---------------------------------------------------------------------------
# ProPR Frontend environment configuration
# Copy this file to `.env` and adjust as needed.
# Vite only exposes variables prefixed with VITE_ to the client bundle.
# ---------------------------------------------------------------------------

# Base URL for the backend REST API (leave empty to use the Vite dev proxy)
VITE_API_URL=http://localhost:5000/api

# Target used by the Vite dev-server proxy for /api requests
VITE_PROXY_TARGET=http://localhost:5000
