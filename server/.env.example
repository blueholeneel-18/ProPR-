# ---------------------------------------------------------------------------
# ProPR Backend environment configuration
# Copy this file to `.env` and adjust the values for your environment.
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL connection (individual values)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=propr

# Alternatively provide a single connection string (takes precedence)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/propr

# Auth (placeholder secret for signing tokens)
JWT_SECRET=change-me-in-production
